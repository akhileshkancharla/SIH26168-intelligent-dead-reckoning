{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sih26168.invalid/contracts/schemas/map_graph_manifest_v1.schema.json",
  "title": "SIH26168 I-21 MapGraphManifest v1",
  "description": "Normative Tier-A contract for a versioned offline map/road-graph package. It records hash-only source and graph lineage; private PBF, SQLite, route and archive bytes remain outside Git and CI.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "map_version",
    "source_pbf_sha256",
    "region_sha256",
    "graph_sha256",
    "display_sha256",
    "toolchain",
    "crs",
    "bounds",
    "notices",
    "route_status"
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifactFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "size_bytes", "sha256"],
      "properties": {
        "filename": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^/\\\\]+$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  },
  "properties": {
    "schema_version": {
      "const": 1
    },
    "map_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "source_pbf_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "region_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "graph_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "display_sha256": {
      "oneOf": [
        {"$ref": "#/$defs/sha256"},
        {"type": "null"}
      ]
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "build_version",
        "python_version",
        "osmium_version",
        "requirements_lock_sha256"
      ],
      "properties": {
        "build_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "python_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$"
        },
        "osmium_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "requirements_lock_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "crs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["geodetic", "axis_order", "local_frame_id", "local_frame_axes", "anchor"],
      "properties": {
        "geodetic": {
          "const": "CRS84/WGS84"
        },
        "axis_order": {
          "const": "longitude,latitude"
        },
        "local_frame_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "local_frame_axes": {
          "const": ["north", "east", "down"]
        },
        "anchor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["longitude_deg", "latitude_deg", "ellipsoid_height_m"],
          "properties": {
            "longitude_deg": {"type": "number", "minimum": -180, "maximum": 180},
            "latitude_deg": {"type": "number", "minimum": -90, "maximum": 90},
            "ellipsoid_height_m": {"type": "number"}
          }
        }
      }
    },
    "bounds": {
      "description": "Authoritative region bounds [west, south, east, north] in CRS84 degrees.",
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {"type": "number", "minimum": -180, "maximum": 180},
        {"type": "number", "minimum": -90, "maximum": 90},
        {"type": "number", "minimum": -180, "maximum": 180},
        {"type": "number", "minimum": -90, "maximum": 90}
      ],
      "items": false
    },
    "notices": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "contains": {
        "type": "string",
        "pattern": "OpenStreetMap"
      }
    },
    "route_status": {
      "enum": ["FIELD_VALIDATION_PENDING", "FIELD_REJECTED", "FIELD_APPROVED"]
    },
    "gate_decision": {
      "enum": ["S6B1-CONDITIONAL", "REJECTED"]
    },
    "graph_logical_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "archive_root", "manifest", "archive"],
      "properties": {
        "artifact": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "archive_root": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^/\\\\]+$"
        },
        "manifest": {
          "$ref": "#/$defs/artifactFile"
        },
        "archive": {
          "$ref": "#/$defs/artifactFile"
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "graph_schema_sha256",
        "node_count",
        "edge_count",
        "way_count",
        "tests_passed",
        "tests_failed",
        "tests_skipped",
        "byte_identical_rebuild",
        "logical_identical_rebuild"
      ],
      "properties": {
        "graph_schema_sha256": {"$ref": "#/$defs/sha256"},
        "node_count": {"type": "integer", "minimum": 1},
        "edge_count": {"type": "integer", "minimum": 1},
        "way_count": {"type": "integer", "minimum": 1},
        "tests_passed": {"type": "integer", "minimum": 1},
        "tests_failed": {"const": 0},
        "tests_skipped": {"const": 0},
        "byte_identical_rebuild": {"const": true},
        "logical_identical_rebuild": {"const": true}
      }
    },
    "source_pbf_redistribution_authorized": {
      "const": false
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
